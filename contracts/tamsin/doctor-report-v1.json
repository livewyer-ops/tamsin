{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamsin.livewyer.io/contracts/doctor-report-v1.json",
  "title": "Tamsin doctor report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "tamsin",
    "tool_version",
    "tool_commit",
    "go",
    "os",
    "arch",
    "profile",
    "online",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "enum": ["pass", "fail"] },
    "tamsin": { "type": "string", "minLength": 1 },
    "tool_version": { "type": "string", "minLength": 1 },
    "tool_commit": { "type": "string", "minLength": 1 },
    "tool_build_date": { "type": "string", "minLength": 1 },
    "go": { "type": "string", "minLength": 1 },
    "os": { "type": "string", "minLength": 1 },
    "arch": { "type": "string", "minLength": 1 },
    "profile": { "$ref": "#/$defs/profile" },
    "online": { "type": "boolean" },
    "endpoint": { "type": "string", "minLength": 1 },
    "auth": {
      "enum": ["auto", "none", "basic", "bearer", "url-token", "oauth-client", "oauth-code"]
    },
    "checks": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/configuration-check" },
        { "$ref": "#/$defs/profile-check" },
        { "$ref": "#/$defs/staging-check" },
        { "$ref": "#/$defs/ffprobe-check" },
        { "$ref": "#/$defs/ffmpeg-check" },
        { "$ref": "#/$defs/authentication-check" },
        { "$ref": "#/$defs/service-check" },
        { "$ref": "#/$defs/api-compatibility-check" },
        { "$ref": "#/$defs/service-lifetimes-check" },
        { "$ref": "#/$defs/storage-backends-check" },
        { "$ref": "#/$defs/storage-selection-check" }
      ],
      "items": false,
      "minItems": 11
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "requires_ffmpeg"],
      "properties": {
        "selection": {
          "type": "string",
          "description": "The requested profile selection, or an empty string when doctor checks the union of local dependencies without selecting an ingest profile."
        },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "segment_duration": { "type": "string", "minLength": 1 },
        "segment_format": { "type": "string", "minLength": 1 },
        "essence_storage": { "type": "string", "minLength": 1 },
        "requires_ffmpeg": { "type": "boolean" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "skipped"] },
        "detail": {
          "type": "object",
          "description": "Extensible, non-secret diagnostic metadata for this check.",
          "additionalProperties": true
        },
        "error": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "fail" } }, "required": ["status"] },
          "then": { "required": ["error"] },
          "else": { "not": { "required": ["error"] } }
        }
      ]
    },
    "configuration-check": {
      "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "name": { "const": "configuration" } } }]
    },
    "profile-check": {
      "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "name": { "const": "profile" } } }]
    },
    "staging-check": {
      "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "name": { "const": "staging" } } }]
    },
    "ffprobe-check": {
      "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "name": { "const": "ffprobe" } } }]
    },
    "ffmpeg-check": {
      "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "name": { "const": "ffmpeg" } } }]
    },
    "authentication-check": {
      "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "name": { "const": "authentication" } } }]
    },
    "service-check": {
      "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "name": { "const": "service" } } }]
    },
    "api-compatibility-check": {
      "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "name": { "const": "api_compatibility" } } }]
    },
    "service-lifetimes-check": {
      "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "name": { "const": "service_lifetimes" } } }]
    },
    "storage-backends-check": {
      "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "name": { "const": "storage_backends" } } }]
    },
    "storage-selection-check": {
      "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "name": { "const": "storage_selection" } } }]
    }
  }
}
