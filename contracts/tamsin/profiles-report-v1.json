{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamsin.livewyer.io/contracts/profiles-report-v1.json",
  "title": "TAMSin built-in profile catalogue report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_policy_version", "profiles"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_policy_version": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "version", "selection", "essence_storage", "segment_duration",
        "segment_format", "ffmpeg", "source_bytes_preserved", "object_pattern",
        "intended_use", "resource_note"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "selection": { "type": "string", "pattern": "^[a-z0-9-]+@[0-9]+$" },
        "essence_storage": { "enum": ["independent", "muxed"] },
        "segment_duration": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)$" },
        "segment_format": { "enum": ["source", "mpegts"] },
        "ffmpeg": { "enum": ["never", "multi_essence_only", "always"] },
        "source_bytes_preserved": { "type": "boolean" },
        "object_pattern": { "type": "string", "minLength": 1 },
        "intended_use": { "type": "string", "minLength": 1 },
        "resource_note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
