# The builder only needs production Go sources and the embedded TAMS schemas. An
# allowlist prevents an untracked credential, media file, or local result from
# being uploaded to a remote BuildKit daemon or retained in its cache.
**
!go.mod
!go.sum
!LICENSE
!scripts/
!scripts/build-third-party-licenses.sh
!cmd/
!cmd/**/
!cmd/**/*.go
!internal/
!internal/**/
!internal/**/*.go
!internal/tamsschema/schemas/**/*.json
**/*_test.go
