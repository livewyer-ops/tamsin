# The documented surface: shorthands, subcommand tree, and the shell
# integrations packagers depend on. These are cheap to break and expensive to
# notice, because nothing else exercises them.

exec tamsin --version
stdout 'tamsin'

exec tamsin --help
stdout 'creates TAMS Flows, and uploads verified Media Objects'
stdout 'ingest'
stdout 'doctor'
stdout 'profiles'

# The removed API surface cannot fall through to implicit ingest. Existing
# automation gets an actionable migration error while the tombstone remains
# absent from help.
! exec tamsin api flow get some-flow
stderr 'moved to tamsctl'

# Profile discovery is config-independent and exposes the complete stable
# catalogue to both operators and wrappers.
exec tamsin profiles
stdout 'preserve@1'
stdout 'demux@1'
stdout 'muxed-segments@1'
stdout 'essence-segments@1'
stdout 'mpegts-segments@1'

exec tamsin --format json profiles
stdout '"schema_version":"1.0"'
stdout '"profile_policy_version":"1"'
! stdout 'editorial|streaming-ts'

exec tamsin doctor --help
stdout '--online'
stdout '--profile'
stdout '--temp-dir'

# Shorthands are part of the published interface.
exec tamsin ingest --help
stdout '-d, --segment-duration'
stdout '-i, --input'
stdout '-j, --concurrency'
stdout '-o, --endpoint'
stdout '--profile'
stdout '--format.*human or json'
stdout '--progress.*auto, plain, or none'
stdout '--color.*auto, always, or never'
stdout '-q, --quiet'
stdout '-v, --verbose'

# --segment-duration is described in TAMS terms, not FFmpeg's.
stdout 'Flow Segment'

# Completions are generated for every shell the docs claim.
exec tamsin completion bash
stdout 'bash completion'
exec tamsin completion zsh
exec tamsin completion fish
exec tamsin completion powershell

# The structured override keeps its documented 10-second default. A required
# profile supplies the complete policy, so this flag default is not a hidden
# ingest-profile default.
exec tamsin ingest --help
stdout 'default 10s'
