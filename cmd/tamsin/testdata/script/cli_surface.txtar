# The documented surface: shorthands, subcommand tree, and the shell
# integrations packagers depend on. These are cheap to break and expensive to
# notice, because nothing else exercises them.

exec tamsin --version
stdout 'tamsin'

exec tamsin --help
stdout 'creates TAMS Flows, and uploads verified Media Objects'
stdout 'ingest'
stdout 'api'
stdout 'doctor'

exec tamsin doctor --help
stdout '--online'
stdout '--profile'
stdout '--temp-dir'

# Shorthands are part of the published interface.
exec tamsin ingest --help
stdout '-d, --segment-duration'
stdout '-i, --input'
stdout '-j, --concurrency'
stdout '-o, --endpoint'
stdout '--profile'
stdout '--format.*human or json'
stdout '--progress.*auto, tty, plain, or none'
stdout '--color.*auto, always, or never'
stdout '-q, --quiet'
stdout '-v, --verbose'

# --segment-duration is described in TAMS terms, not FFmpeg's.
stdout 'Flow Segment'

# The API subcommand tree covers the pinned ingest operations.
exec tamsin api --help
stdout 'flow'
stdout 'segment'
stdout 'storage'
stdout 'object'
stdout 'request'

# Segment deletion is reachable without dropping to a raw request.
exec tamsin api segment --help
stdout 'delete'

# Segment listings are lean unless download URLs are explicitly requested.
exec tamsin api segment list --help
stdout '--include-download-urls'

# Deleting Segments requires an explicit timerange rather than defaulting to
# the unbounded one, so a whole Flow cannot be emptied by omission.
! exec tamsin api segment delete some-flow
stderr 'timerange'
! exec tamsin api segment delete some-flow --timerange '[0:0_1:0)'
stderr 'object-id'

# Completions are generated for every shell the docs claim.
exec tamsin completion bash
stdout 'bash completion'
exec tamsin completion zsh
exec tamsin completion fish
exec tamsin completion powershell

# Segmentation is on by default, at a target of 10 seconds. This is load-bearing:
# it makes ffmpeg a runtime requirement for every ingest, including dry runs.
exec tamsin ingest --help
stdout 'default 10s'
